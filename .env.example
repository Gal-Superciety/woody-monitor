# --- LP holders, snapshots, and rewards ---
LP_HOLDERS_PAGE_SIZE=100
LP_HOLDERS_MAX_PAGES=20
LP_SNAPSHOT_CHECK_INTERVAL=3600
LP_SNAPSHOT_FILE=data/lp_snapshots.json
LP_REWARDS_FILE=data/lp_rewards.json
LP_EXPORT_REWARD_POOL_EGLD=0
