ROOT_MAX_AGE_SECONDS=90
CHECK_HOLDERS_INTERVAL=120
WS_RECONNECT_DELAY=8
API_TIMEOUT_SECONDS=10
PRICE_TTL_SECONDS=20
POOL_SNAPSHOT_TTL_SECONDS=20
